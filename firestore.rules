rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ログインしている人（匿名ログインを含む）
    function signedIn() {
      return request.auth != null;
    }

    // 管理者：このGoogleアカウントでログインした人だけ
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'kashiko.pr@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 受講生が自分のデータとして書き換えてよい項目だけを許可する
    function memberEdit() {
      let d = request.resource.data.diff(resource.data).affectedKeys();
      return d.hasOnly(['nickname', 'lastLogin', 'bonusPts', 'streak', 'lastBonus', 'bonusDays',
                        'attendance', 'missions', 'gachaCount', 'gachaLog', 'reward'])
        // ニックネームは、まだ空のときに1回だけ決められる
        && (!d.hasAny(['nickname'])
            || (resource.data.nickname == ''
                && request.resource.data.nickname is string
                && request.resource.data.nickname.size() > 0
                && request.resource.data.nickname.size() <= 12))
        // 個別相談は「申し込み」にだけ変えられる（対応済みにできるのは管理者）
        && (!d.hasAny(['reward'])
            || (resource.data.reward == 'none' && request.resource.data.reward == 'requested'));
    }

    // 受講生：ドキュメントID ＝ 招待コード
    match /members/{code} {
      allow get: if signedIn();                 // コードを知っている人だけが、1件ずつ読める
      allow list: if isAdmin();                 // 一覧を見られるのは管理者だけ
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.active == true && memberEdit());
    }

    // ガチャのお題
    match /topics/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
